[Unit]
Description=Glissa result file server for tailnet links
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=8
OnFailure=glissa-alert@results.service

[Service]
Environment=PATH=%h/.bun/bin:%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Type=simple
EnvironmentFile=-%h/.config/glissa/local.env
ExecStart=/usr/bin/env glissa script serve-results.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

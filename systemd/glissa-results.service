[Unit]
Description=Glissa result file server for tailnet links
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=8
OnFailure=glissa-alert@results.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/Glissa
EnvironmentFile=-%h/.config/glissa/local.env
ExecStart=/usr/bin/node %h/Projects/Glissa/scripts/serve-results.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

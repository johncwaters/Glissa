[Unit]
Description=Dispatch %i work to Glissa service
After=glissa.service
OnFailure=glissa-alert@%i.service

[Service]
Environment=PATH=%h/.bun/bin:%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Type=oneshot
EnvironmentFile=-%h/.config/glissa/local.env
ExecStart=/usr/bin/env glissa script dispatch.mjs %i

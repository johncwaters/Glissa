[Unit]
Description=Glissa on Telegram
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=8
OnFailure=glissa-alert@service.service

[Service]
Type=simple
Environment=PATH=%h/.bun/bin:%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
EnvironmentFile=-%h/.config/glissa/local.env
ExecStart=/usr/bin/env glissa serve
Restart=always
RestartSec=5
TimeoutStopSec=660
KillMode=mixed

[Install]
WantedBy=default.target
